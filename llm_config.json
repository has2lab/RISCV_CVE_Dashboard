{
  "default": {
    "provider": "openai",
    "model": "deepseek-chat"
  },
  "openai": {
    "api_key": "",
    "base_url": "https://api.deepseek.com/v1",
    "models": [
      "deepseek-chat",
      "deepseek-reasoner"
    ],
    "default_model": "deepseek-chat",
    "temperature": 0.6,
    "max_tokens": 10000,
    "timeout": 60,
    "rate_limit_delay": 1.0
  },
  "anthropic": {
    "api_key": "",
    "models": [
      "claude-3-opus-20240229",
      "claude-3-sonnet-20240229",
      "claude-3-haiku-20240307"
    ],
    "default_model": "claude-3-sonnet-20240229",
    "max_tokens": 10000,
    "timeout": 30,
    "rate_limit_delay": 0.5
  },
  "local": {
    "base_url": "http://localhost:11434",
    "models": [
      "llama2",
      "mistral",
      "qwen"
    ],
    "default_model": "llama2",
    "temperature": 0.3,
    "max_tokens": 1000,
    "timeout": 60
  },
  "custom": {
    "api_key": "",
    "base_url": "",
    "model": "",
    "temperature": 0.3,
    "max_tokens": 1000,
    "timeout": 30,
    "rate_limit_delay": 0.5
  },
  "embedding": {
    "provider": "dashscope",
    "api_key": "",
    "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "model": "text-embedding-v4",
    "dimensions": 1024,
    "batch_size": 10,
    "timeout": 60,
    "env_var": "DASHSCOPE_API_KEY"
  },
  "verification": {
    "max_cves_per_batch": 5,
    "clustering_method": "hdbscan",
    "min_cluster_size": 3,
    "max_retries": 5,
    "initial_retry_delay": 1.0,
    "max_retry_delay": 60.0,
    "retry_multiplier": 2.0,
    "system_prompt": "You are a cybersecurity expert specializing in RISC-V architecture. Your task is to determine whether CVEs are related to RISC-V ecosystem.",
    "riscv_criteria": [
      "RISC-V Process",
      "RISC-V SoC",
      "RISC-V instruction set",
      "RISC-V Simulator",
      "RISC-V Vulnerabilities",
      "RISC-V Development Tools",
      "RISC-V Firmware or Applications"
    ]
  },
  "classification": {
    "predefined_categories": [
      "Linux Kernel",
      "RISC-V CPU/SoC",
      "Simulator",
      "RISC-V Development Tools",
      "Device-Specific Firmware & Applications",
      "RISC-V Instruction Set Manual",
      "Other"
    ],
    "allow_new_categories": true,
    "system_prompt": "You are a cybersecurity expert specializing in RISC-V architecture vulnerabilities."
  },
  "output": {
    "save_original_data": true,
    "generate_report": true,
    "generate_summary": true
  }
}
